<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical|end"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="14sp"
            android:maxLines="3"
            android:gravity="end"
            android:text="" />

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="18sp"
            android:text="" />

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="#212121"
            android:textSize="48sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#E0E0E0"
        android:layout_marginHorizontal="16dp"/>

    <GridLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="false">

        <Button android:id="@+id/btnClear" android:text="AC" android:textColor="#F44336" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btnNegate" android:text="+/-" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btnPercent" android:text="%" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btnDivide" android:text="÷" android:textColor="#FF9800" style="@style/CalculatorDigitButton" android:textSize="22sp" />

        <Button android:id="@+id/btn1" android:text="1" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btn2" android:text="2" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btn3" android:text="3" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btnMultiply" android:text="×" style="@style/CalculatorOpButton" android:textSize="22sp" />

        <Button android:id="@+id/btn4" android:text="4" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btn5" android:text="5" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btn6" android:text="6" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btnMinus" android:text="−" style="@style/CalculatorOpButton" android:textSize="22sp" />

        <Button android:id="@+id/btn7" android:text="7" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btn8" android:text="8" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btn9" android:text="9" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btnPlus" android:text="+" style="@style/CalculatorOpButton" android:textSize="22sp" />

        <Button android:id="@+id/btn0" android:text="0" android:layout_columnSpan="2" android:layout_columnWeight="2" style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btnDot" android:text="." style="@style/CalculatorDigitButton" android:textSize="18sp" />
        <Button android:id="@+id/btnEquals" android:text="=" android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_gravity="fill" android:textSize="22sp" />

    </GridLayout>
</LinearLayout>
